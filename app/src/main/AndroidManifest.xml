<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"

        android:theme="@style/Theme.EternalReturnInfo"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">
        <!-- 이용 통계(Firebase Analytics) 수집을 끈다. 개인정보처리방침에 수집 항목으로 적지 않는다. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <activity
            android:name=".presentation.activity.main.WebView"
            android:exported="false" />
        <activity
            android:name=".presentation.activity.board.BoardDeletedActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activity.board.BoardSearchActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activity.board.BoardUpdateActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activity.board.BoardPostActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activity.board.BoardAddActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activity.chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activity.main.MainActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.activity.Intro.SplashActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.activity.login.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.activity.login.LoginActivity"
            android:exported="false" />
    </application>

</manifest>

