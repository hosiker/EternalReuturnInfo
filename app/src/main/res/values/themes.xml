<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EternalReturnInfo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->

        <!-- No Title Bar-->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- 레이아웃에서 배경을 빠뜨린 영역(상태바·내비게이션 바 여백 등)에 흰색이 비치지 않게 창 기본 배경을 검정으로 -->
        <item name="android:windowBackground">@color/black</item>
        <!-- 앱 화면이 모두 검은 배경이므로 상태바 아이콘은 밝은 색 (edge-to-edge 에서 배경 위에 그려진다) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EternalReturnInfo" parent="Base.Theme.EternalReturnInfo" />

    <style name="ThemeToolbar" parent="Theme.AppCompat.Light">
        <!-- color of the menu overflow icon -->
        <item name="android:textColorSecondary">@color/white</item>
    </style>

    <style name="Round" parent="">
        <item name="cornerSize">10%</item>
    </style>

    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">0000</item>
        <item name="postSplashScreenTheme">@style/Theme.EternalReturnInfo</item>
    </style>

    <!-- 아래에서 올라오는 동의 시트(Dialog) -->
    <style name="ConsentSheetDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="MainTabText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">11sp</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>