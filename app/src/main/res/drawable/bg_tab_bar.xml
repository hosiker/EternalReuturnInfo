<?xml version="1.0" encoding="utf-8"?>
<!-- 하단 탭 바: 검정 바탕 + 위쪽 얇은 구분선 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
        </shape>
    </item>
    <item android:bottom="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_stroke" />
        </shape>
    </item>
</layer-list>
