<?xml version="1.0" encoding="utf-8"?>
<!-- 기존 이용자에게 앱을 열 때 한 번 띄우는 동의 시트 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_sheet_bg"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/terms_gate_title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="@string/terms_gate_sub"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <include
        android:id="@+id/sheet_consent"
        layout="@layout/consent_checks" />

    <Button
        android:id="@+id/sheet_agree_btn"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/shape_btn_primary"
        android:stateListAnimator="@null"
        android:text="@string/terms_gate_agree"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/sheet_decline_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="2dp"
        android:background="@null"
        android:text="@string/terms_gate_decline"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
