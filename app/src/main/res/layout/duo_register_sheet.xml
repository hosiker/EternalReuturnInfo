<?xml version="1.0" encoding="utf-8"?>
<!-- 듀오 모집 등록 시트 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_sheet_bg"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duo_reg_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/duo_reg_sub"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView style="@style/DuoLabel" android:text="@string/duo_reg_server" />
            <LinearLayout
                android:id="@+id/reg_server_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView style="@style/DuoLabel" android:text="@string/duo_reg_gender" />
            <LinearLayout
                android:id="@+id/reg_gender_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView style="@style/DuoLabel" android:text="@string/duo_reg_most" />
            <LinearLayout
                android:id="@+id/reg_most_row"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/shape_input_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/reg_most_face"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:civ_circle_background_color="@color/surface_stroke" />

                <TextView
                    android:id="@+id/reg_most_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/duo_reg_most_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dropdown_arrow" />
            </LinearLayout>

            <TextView style="@style/DuoLabel" android:text="@string/duo_reg_tier" />
            <TextView
                android:id="@+id/reg_tier_text"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/shape_input_field"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/duo_reg_tier_loading"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <HorizontalScrollView
                android:id="@+id/reg_tier_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/reg_tier_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/reg_submit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/shape_btn_primary"
            android:stateListAnimator="@null"
            android:text="@string/duo_reg_submit"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
