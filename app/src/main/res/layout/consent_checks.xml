<?xml version="1.0" encoding="utf-8"?>
<!-- 약관 동의 항목. 회원가입 화면(아래쪽)과 기존 이용자용 동의 시트가 함께 쓴다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <CheckBox
        android:id="@+id/consent_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_surface_card"
        android:buttonTint="@color/checkbox_tint"
        android:minHeight="52dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:text="@string/consent_all"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/consent_terms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/checkbox_tint"
            android:minHeight="44dp"
            android:paddingStart="8dp"
            android:text="@string/consent_terms"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/consent_terms_view"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/consent_view"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/consent_privacy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/checkbox_tint"
            android:minHeight="44dp"
            android:paddingStart="8dp"
            android:text="@string/consent_privacy"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/consent_privacy_view"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/consent_view"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/consent_age"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:buttonTint="@color/checkbox_tint"
        android:minHeight="44dp"
        android:paddingStart="8dp"
        android:text="@string/consent_age"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/consent_summary"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
